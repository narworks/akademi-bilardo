---
import siteData from '../content/site.json';
---

<section class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="section-title text-dark">{siteData.testimonials.title}</h2>
    <div class="h-1 w-16 bg-primary mx-auto mb-12 rounded-full"></div>

    <div class="grid md:grid-cols-3 gap-8">
      {siteData.testimonials.items.map((item) => (
        <div class="bg-gray-50 rounded-2xl p-8 relative">
          <!-- Quote icon -->
          <svg class="w-10 h-10 text-primary/20 mb-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
          </svg>
          <p class="text-gray-600 leading-relaxed mb-6 italic">
            "{item.text}"
          </p>
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center">
              <span class="text-primary font-bold text-sm">
                {item.name.split(' ').map(n => n[0]).join('')}
              </span>
            </div>
            <span class="font-semibold text-dark">{item.name}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

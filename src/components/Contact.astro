---
import siteData from '../content/site.json';
---

<section id="iletisim" class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="section-title text-dark">İletişim</h2>
    <div class="h-1 w-16 bg-primary mx-auto mb-12 rounded-full"></div>

    <div class="grid md:grid-cols-2 gap-12">
      <!-- Contact Info -->
      <div class="space-y-8">
        <!-- Phone -->
        <div class="flex items-start gap-4">
          <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center flex-shrink-0">
            <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
          </div>
          <div>
            <h3 class="font-semibold text-dark mb-1">Telefon</h3>
            <p class="text-gray-500 text-sm mb-1">{siteData.contact.phonePerson}</p>
            <a href={`tel:${siteData.contact.phoneFormatted}`} class="text-primary hover:text-primary-dark font-medium text-lg transition-colors">
              {siteData.contact.phone}
            </a>
          </div>
        </div>

        <!-- Email -->
        <div class="flex items-start gap-4">
          <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center flex-shrink-0">
            <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </div>
          <div>
            <h3 class="font-semibold text-dark mb-1">E-posta</h3>
            <a href={`mailto:${siteData.contact.email}`} class="text-primary hover:text-primary-dark transition-colors">
              {siteData.contact.email}
            </a>
          </div>
        </div>

        <!-- Hours -->
        <div class="flex items-start gap-4">
          <div class="w-12 h-12 rounded-xl bg-green-50 flex items-center justify-center flex-shrink-0">
            <svg class="w-6 h-6 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <div>
            <h3 class="font-semibold text-dark mb-1">Çalışma Saatleri</h3>
            <p class="text-green-600 font-medium text-lg">{siteData.contact.hours}</p>
          </div>
        </div>

        <!-- Address -->
        <div class="flex items-start gap-4">
          <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center flex-shrink-0">
            <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
          </div>
          <div>
            <h3 class="font-semibold text-dark mb-1">Adres</h3>
            <p class="text-gray-600">{siteData.contact.address}</p>
          </div>
        </div>
      </div>

      <!-- Google Maps Embed -->
      <div class="aspect-square md:aspect-auto rounded-2xl overflow-hidden shadow-lg bg-gray-100">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3190.8!2d27.4!3d37.03!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMzfCsDAyJzAuMCJOIDI3wrAyNCcwLjAiRQ!5e0!3m2!1str!2str!4v1"
          width="100%"
          height="100%"
          style="border:0; min-height: 400px;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Akademi Bilardo konum haritası"
        ></iframe>
      </div>
    </div>
  </div>
</section>
